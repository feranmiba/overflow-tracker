{
  "name": "solidity-overflow-tracker",
  "displayName": "Solidity Overflow Tracker",
  "description": "Solidity smart contract linter for static code analysis.",
  "version": "0.0.1",
  "publisher": "AmiolaOluwademilade",
  "author": {
    "name": "Amiola Oluwademilade"
  },
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/feranmiba/overflow-tracker.git"
  },
  "homepage": "https://github.com/feranmiba/overflow-tracker#readme",
  "bugs": {
    "url": "https://github.com/feranmiba/overflow-tracker/issues"
  },
  "keywords": [
    "solidity",
    "linter"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:solidity"
  ],
  "contributes": {
    "commands": [
      {
        "command": "overflow-tracker.scanFile",
        "title": "Overflow Tracker: Scan Solidity File"
      },
      {
        "command": "overflow-tracker.clearDiagnostics",
        "title": "Overflow Tracker: Clear Overflow Diagnostics"
      },
      {
        "command": "overflow-tracker.ignoreLine",
        "title": "Overflow Tracker: Dismiss Highlight on Current Line"
      }
    ],
    "languages": [
      {
        "id": "solidity",
        "extensions": [
          ".sol"
        ],
        "aliases": [
          "Solidity",
          "solidity"
        ]
      }
    ],
    "configuration": {
      "id": "overflowTracker",
      "type": "object",
      "title": "Solidity Overflow Tracker",
      "properties": {
        "overflowTracker.enableRealTimeScanning": {
          "type": "boolean",
          "default": true,
          "description": "Enable real-time scanning for overflow/underflow risks on typing."
        },
        "overflowTracker.warnUncheckedBlocks": {
          "type": "boolean",
          "default": true,
          "description": "Warn when arithmetic operations are performed inside 'unchecked' blocks in Solidity >=0.8.0."
        },
        "overflowTracker.warnPre080WithoutSafeMath": {
          "type": "boolean",
          "default": true,
          "description": "Warn when raw arithmetic operators (+, -, *, **) are used in Solidity <0.8.0."
        },
        "overflowTracker.warnDowncasting": {
          "type": "boolean",
          "default": true,
          "description": "Warn on explicit integer downcasting (e.g., uint256 to uint8) that may overflow/truncate."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "build": "node esbuild.js",
    "watch-esbuild": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.3"
  }
}
